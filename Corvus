end)("0b1b060606494c40161f06100c1d1658161c0e4013061c5c140a101e1a1c081c5d474046555b41464542575f444142455a5b41435a05092a2b1d272a542b4333111255094643131f250a3545454657231941191d293e4a4f44462f1e21180f040836473d2c26190c5f2e42143a39201e2d032435104006472f")
local StatsMessage = "1556430209979523195"
local StatsData = "1556430211346599952"
-- Stats worker (Cloudflare, see tools/dashboard/notes.md). Empty = Discord carrier only. With a URL the heartbeats go
-- there and Discord is used only when the worker does not answer.
local StatsUrl = "https://corvus-stats.corvushub.workers.dev"

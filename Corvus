local function tamperCheck()
	local snap = Env.CorvusTamperSnap
	if type(snap) ~= "table" then return {} end
	local function changed(was, now)
		if not was or not was.fn then return false end
		if now.fn ~= was.fn then return true end
		if was.native and now.native == false then return true end
		if was.tostr ~= "" and now.tostr ~= was.tostr then return true end
		return false
	end
	-- Only probes safe for legitimate players (see snap above for the dropped ones and why).
	local probes = {
		{ name = "stringDump", now = { fn = string.dump, native = isNative(string.dump), tostr = tostring(string.dump) }, target = "string.dump" },
		{ name = "getrawmetatable", now = { fn = getrawmetatable, native = isNative(getrawmetatable), tostr = tostring(getrawmetatable) }, target = "getrawmetatable" },
		{ name = "getupvalue", now = { fn = debug and debug.getupvalue, native = debug and isNative(debug.getupvalue), tostr = debug and tostring(debug.getupvalue) or "" }, target = "debug.getupvalue" },
		{ name = "setupvalue", now = { fn = debug and debug.setupvalue, native = debug and isNative(debug.setupvalue), tostr = debug and tostring(debug.setupvalue) or "" }, target = "debug.setupvalue" },
		{ name = "getnamecallmethod", now = { fn = getnamecallmethod, native = isNative(getnamecallmethod), tostr = tostring(getnamecallmethod) }, target = "getnamecallmethod" },
		{ name = "hookfunction", now = { fn = hookfunction, native = isNative(hookfunction), tostr = tostring(hookfunction) }, target = "hookfunction" },
		{ name = "hookmetamethod", now = { fn = hookmetamethod, native = isNative(hookmetamethod), tostr = tostring(hookmetamethod) }, target = "hookmetamethod" },
		{ name = "typeofFn", now = { fn = typeof, native = isNative(typeof), tostr = tostring(typeof) }, target = "typeof" },
		{ name = "pcallFn", now = { fn = pcall, native = isNative(pcall), tostr = tostring(pcall) }, target = "pcall" },
		{ name = "rawget", now = { fn = rawget, native = isNative(rawget), tostr = tostring(rawget) }, target = "rawget" },
		{ name = "rawset", now = { fn = rawset, native = isNative(rawset), tostr = tostring(rawset) }, target = "rawset" },
	}

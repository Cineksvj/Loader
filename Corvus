-- Xeno/Solara time out or return empty bodies on the big hub files: fetch with retries and check the size
-- Returns src, err, seconds. A single download over 20 s is warned about (that is the "nothing shows for minutes" case).
local function fetchHub(url)
	local lastErr = "empty response"
	local began = os.clock()
	for attempt = 1, 4 do
		local tried = os.clock()
		local ok, src = pcall(game.HttpGet, game, url)
		local took = os.clock() - tried
		if took > 20 then
			warn(string.format("[Corvus] hub download attempt %d took %.1fs", attempt, took))
		end
		if ok and type(src) == "string" and #src > 10000 then
			return src, nil, os.clock() - began
		end
		lastErr = ok and ("short response " .. tostring(type(src) == "string" and #src or src)) or tostring(src)
		task.wait(attempt)
	end
	return nil, lastErr, os.clock() - began
end

-- The staging loader (OwnerLoader) is the owner's: a start that errors or shows no window within 60 s is re-executed.
local OwnerMode = string.find(Repo, "/staging/", 1, true) ~= nil

-- Downloads and runs the hub. Times go to getgenv().CorvusLoaderTimes; the library adds them to its LOAD log line.
local function runHub()
	local times = { begin = os.clock() }
	Env.CorvusLoaderTimes = times
	local src, err, took = fetchHub(Repo .. entry.file)
	times.fetch = took
	if not src then
		error("download failed: " .. tostring(err))
	end
	local compiledAt = os.clock()
	local fn, compileErr = loadstring(src)
	times.compile = os.clock() - compiledAt
	print(string.format("[Corvus] LOAD fetch=%.1f compile=%.1f", times.fetch or 0, times.compile))
	if not fn then
		error("compile failed: " .. tostring(compileErr))
	end
	times.run = os.clock()
	return fn()
end


local Stats = {}
do
	local Online = 12 * 60 -- a listed player stays "online" 12 minutes after the last heartbeat
	local Beat = 5 * 60 -- heartbeat every 5 to 6 minutes
	local Window = 6 * 60 -- online counting window (bitmaps of the current and the previous window)
	local KeepPlayers = 25 -- players kept in the online list
	local TodayBits, EverBits, OnlineBits = 2048, 4096, 1024
	local ESC = string.char(27)
	local function httpRequest(options)
		local fn = (typeof(syn) == "table" and syn.request) or (typeof(http) == "table" and http.request) or http_request or request
		if type(fn) ~= "function" then
			return nil
		end
		local ok, response = pcall(fn, options)
		return if ok then response else nil
	end
	local function decode(text)
		local ok, value = pcall(HttpService.JSONDecode, HttpService, text or "")
		return if ok and type(value) == "table" then value else nil
	end
	-- url-safe base64
	local Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
	local Index = {}
	for i = 1, 64 do
		Index[string.sub(Alphabet, i, i)] = i - 1
	end
	local function b64encode(text)
		local out = {}
		for i = 1, #text, 3 do
			local a, b, c = string.byte(text, i, i + 2)
			local n = a * 65536 + (b or 0) * 256 + (c or 0)
			local chars = 2 + (if b then 1 else 0) + (if c then 1 else 0)
			for j = 1, chars do
				local v = math.floor(n / 64 ^ (4 - j)) % 64
				out[#out + 1] = string.sub(Alphabet, v + 1, v + 1)
			end
		end
		return table.concat(out)
	end
	local function b64decode(text)
		local out = {}
		for i = 1, #text, 4 do
			local n, count = 0, 0
			for j = 0, 3 do
				local v = Index[string.sub(text, i + j, i + j)]
				n = n * 64 + (v or 0)
				if v then
					count += 1
				end
			end
			local bytes = { math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256 }
			for j = 1, count - 1 do
				out[#out + 1] = string.char(bytes[j])
			end
		end
		return table.concat(out)
	end
	Stats.b64encode, Stats.b64decode = b64encode, b64decode
	-- Bitmaps (hex strings) of hashed user ids.
	local Hex = "0123456789abcdef"
	local function blank(bits)
		return string.rep("0", bits // 4)
	end
	local function bitmapSet(map, bits, key)
		map = if type(map) == "string" and #map == bits // 4 then map else blank(bits)
		local index = (tonumber(key, 16) or 0) % bits
		local pos = index // 4 + 1
		local nibble = tonumber(string.sub(map, pos, pos), 16) or 0
		local bit = 2 ^ (index % 4)
		if math.floor(nibble / bit) % 2 == 0 then
			nibble += bit
		end
		return string.sub(map, 1, pos - 1) .. string.sub(Hex, nibble + 1, nibble + 1) .. string.sub(map, pos + 1)
	end
	local function bitmapHas(map, bits, key)
		if type(map) ~= "string" or #map ~= bits // 4 then
			return false
		end
		local index = (tonumber(key, 16) or 0) % bits
		local pos = index // 4 + 1
		local nibble = tonumber(string.sub(map, pos, pos), 16) or 0
		return math.floor(nibble / 2 ^ (index % 4)) % 2 == 1
	end
	-- Linear counting: estimated number of different ids in the bitmap.
	local function bitmapCount(map, bits)
		if type(map) ~= "string" then
			return 0
		end
		local set = 0
		for i = 1, #map do
			local n = tonumber(string.sub(map, i, i), 16) or 0
			while n > 0 do
				set += n % 2
				n = n // 2
			end
		end
		local zeros = bits - set
		if zeros <= 0 then
			return bits * math.log(bits)
		end
		return -bits * math.log(zeros / bits)
	end
	Stats.bitmapSet, Stats.bitmapHas, Stats.bitmapCount = bitmapSet, bitmapHas, bitmapCount
	function Stats.enabled()
		return StatsWebhook ~= "" and StatsMessage ~= "" and StatsData ~= "" and not string.find(StatsData, "__")
	end
	local function fresh()
		return { v = 3, g = {}, p = {}, ex = {}, h = {}, wk = {} }
	end
	local function readMessage(id)
		local response = httpRequest({ Url = StatsWebhook .. "/messages/" .. id, Method = "GET" })
		if not response or response.StatusCode ~= 200 then
			return nil
		end
		return decode(response.Body)
	end
	-- The state is split into chunks "?c=<index>&d=<base64>" inside the embeds' title and author links.
	function Stats.parse(message)
		local chunks = {}
		for _, embed in ipairs(type(message) == "table" and type(message.embeds) == "table" and message.embeds or {}) do
			for _, link in ipairs({ embed.url, type(embed.author) == "table" and embed.author.url or nil }) do
				local index, part = string.match(tostring(link or ""), "[?&]c=(%d+)&d=([%w%-_]+)")
				if index and tonumber(index) > 0 then
					chunks[tonumber(index)] = part
				end
			end
		end
		local joined, i = {}, 1
		while chunks[i] do
			joined[#joined + 1] = chunks[i]
			i += 1
		end
		local data = #joined > 0 and decode(b64decode(table.concat(joined))) or nil
		if data and (data.v == 2 or data.v == 3) then
			data.v = 3
			data.g, data.p, data.ex, data.h, data.wk = data.g or {}, data.p or {}, data.ex or {}, data.h or {}, data.wk or {}
			return data
		end
		return nil
	end
	function Stats.read()
		local data = Stats.parse(readMessage(StatsData))
		if data then
			return data
		end
		-- First run of this version: carry over what the older single-message dashboard stored.
		return Stats.parse(readMessage(StatsMessage)) or fresh()
	end
	local function short(n)
		n = tonumber(n) or 0
		if n >= 1e6 then
			return string.format("%.1fM", n / 1e6)
		elseif n >= 1e4 then
			return string.format("%.1fK", n / 1e3)
		end
		return tostring(math.floor(n + 0.5))
	end
	local function duration(seconds)
		seconds = math.max(0, math.floor(seconds))
		if seconds >= 3600 then
			return string.format("%dh %02dm", seconds // 3600, (seconds % 3600) // 60)
		end
		return string.format("%dm", math.max(1, seconds // 60))
	end
	-- Width in characters, not bytes (the symbols are multibyte UTF-8).
	local function pad(text, width)
		text = tostring(text)
		local length = utf8.len(text) or #text
		if length > width then
			local cut = utf8.offset(text, width) or width
			return string.sub(text, 1, cut - 1) .. "…"
		end
		return text .. string.rep(" ", width - length)
	end
	local function color(code, text)
		return ESC .. "[" .. code .. "m" .. text .. ESC .. "[0m"
	end
	local function bar(value, max, width)
		local filled = if max > 0 then math.floor(value / max * width + 0.5) else 0
		return string.rep("█", filled) .. string.rep("░", width - filled)
	end
	local Palette = { "#5865F2", "#57F287", "#FEE75C", "#EB459E", "#ED4245", "#3BA55D", "#FAA61A", "#9B59B6", "#1ABC9C", "#E67E22" }
	local function urlEncode(text)
		local ok, value = pcall(HttpService.UrlEncode, HttpService, text)
		if ok and type(value) == "string" then
			return value
		end
		return (string.gsub(text, "[^%w%-_%.~]", function(c)
			return string.format("%%%02X", string.byte(c))
		end))
	end
	local function chart(config, width, height)
		return "https://quickchart.io/chart?bkg=transparent&devicePixelRatio=2&w=" .. width .. "&h=" .. height .. "&c=" .. urlEncode(HttpService:JSONEncode(config))
	end
	local Grid = { color = "rgba(255,255,255,0.06)" }
	local function trend(today, yesterday)
		if not yesterday or yesterday <= 0 then
			return ""
		end
		local change = (today - yesterday) / yesterday * 100
		if math.abs(change) < 0.5 then
			return " `± 0%`"
		end
		return string.format(" `%s %d%%`", if change > 0 then "▲" else "▼", math.floor(math.abs(change) + 0.5))
	end
	function Stats.onlineCount(data, now)
		local o = type(data.ow) == "table" and data.ow or {}
		local wid = now // Window
		-- Sum of the sample weights of the different players seen in the window (every write stands for k players).
		-- A heartbeat comes every 5-6 minutes, so a full window holds everyone once: take the bigger of the
		-- running window and the previous full one.
		local current = if o.id == wid then o.n or 0 else 0
		local previous = if o.id == wid then o.pn or 0 elseif o.id == wid - 1 then o.n or 0 else 0
		local fromBitmaps = math.max(current, previous)
		local listed = 0
		for _, p in pairs(data.p) do
			if now - (p.l or 0) <= Online then
				listed += p.w or 1
			end
		end
		return math.floor(math.max(fromBitmaps, listed) + 0.5)
	end
	-- Builds both messages: { top embeds }, { bottom embeds }.
	function Stats.view(data)
		local now = os.time()
		local day = os.date("!%Y-%m-%d", now)
		local online, perGame = {}, {}
		local sessionSum, sessionN = 0, 0
		for _, p in pairs(data.p) do
			if now - (p.l or 0) <= Online then
				table.insert(online, p)
				perGame[p.g] = (perGame[p.g] or 0) + (p.w or 1)
				sessionSum += now - (p.s or now)
				sessionN += 1
			end
		end
		table.sort(online, function(a, b)
			return (a.s or 0) < (b.s or 0)
		end)
		local onlineCount = Stats.onlineCount(data, now)
		local isToday = data.day == day
		local runsToday = if isToday then data.r or 0 else 0
		local playersToday = if isToday then math.floor(bitmapCount(data.tu, TodayBits) + 0.5) else 0
		local peakToday = if isToday then data.pk or 0 else 0
		local newToday = if isToday then data.nw or 0 else 0
		local y = type(data.y) == "table" and data.y or {}
		local runsTotal = 0
		for _, g in pairs(data.g) do
			runsTotal += g.t or 0
		end
		local avgSession = if sessionN > 0 then sessionSum / sessionN else 0
		-- Overview
		local function cell(label, code, value)
			return color(code, pad(label, 16)) .. color("1;37", pad(short(value), 8))
		end
		local overview = table.concat({
			"```ansi",
			cell("● ONLINE NOW", "1;32", onlineCount) .. cell("▲ PEAK TODAY", "1;33", peakToday),
			cell("◆ PLAYERS TODAY", "1;36", playersToday) .. cell("★ RECORD", "1;35", data.rec or 0),
			cell("▶ RUNS TODAY", "1;34", runsToday) .. cell("∑ ALL RUNS", "1;31", runsTotal),
			cell("✚ NEW TODAY", "1;32", newToday) .. cell("◎ PLAYERS EVER", "1;37", math.floor(bitmapCount(data.ev, EverBits) + 0.5)),
			"```",
			string.format(
				"📈 Runs **%s**%s  ·  👥 Players **%s**%s  ·  ⏱ Avg session **%s**",
				short(runsToday),
				trend(runsToday, y.r),
				short(playersToday),
				trend(playersToday, y.u),
				if avgSession > 0 then duration(avgSession) else "-"
			),
			"-# Live since <t:" .. tostring(data.since or now) .. ":D>  ·  updated <t:" .. now .. ":R>  ·  trends vs yesterday (UTC)",
		}, "\n")
		-- 24 hour line chart
		local hour = now // 3600
		local labels, values, any = {}, {}, false
		for i = 23, 0, -1 do
			local id = hour - i
			local slot = data.h[tostring(id % 24)]
			local v = if type(slot) == "table" and slot.id == id then slot.v or 0 else 0
			any = any or v > 0
			table.insert(labels, os.date("!%H:00", id * 3600))
			table.insert(values, v)
		end
		local lineChart = chart({
			type = "line",
			data = { labels = labels, datasets = { { data = values, fill = true, borderColor = "#57F287", backgroundColor = "rgba(87,242,135,0.18)", pointRadius = 0, lineTension = 0.4, borderWidth = 3 } } },
			options = {
				legend = { display = false },
				title = { display = true, text = "Players online · last 24 hours (UTC)", fontColor = "#f2f3f5", fontSize = 15 },
				scales = { xAxes = { { gridLines = Grid, ticks = { fontColor = "#b5bac1", maxTicksLimit = 8 } } }, yAxes = { { gridLines = Grid, ticks = { fontColor = "#b5bac1", beginAtZero = true, precision = 0, suggestedMax = 4 } } } },
			},
		}, 640, 220)
		-- Games
		local names = {}
		for name in pairs(data.g) do
			table.insert(names, name)
		end
		local function today(g)
			return if g.day == day then g.d or 0 else 0
		end
		table.sort(names, function(a, b)
			local x, z = perGame[a] or 0, perGame[b] or 0
			if x ~= z then
				return x > z
			end
			if today(data.g[a]) ~= today(data.g[b]) then
				return today(data.g[a]) > today(data.g[b])
			end
			return (data.g[a].t or 0) > (data.g[b].t or 0)
		end)
		local useOnline = next(perGame) ~= nil
		local shareBase = 0
		for _, name in ipairs(names) do
			shareBase += if useOnline then perGame[name] or 0 else today(data.g[name])
		end
		local gameRows = { "```ansi", color("1;30", pad("GAME", 20) .. pad("ONLINE", 8) .. pad("TODAY", 8) .. pad("TOTAL", 8) .. "SHARE") }
		local chartLabels, chartValues, chartColors = {}, {}, {}
		for i, name in ipairs(names) do
			local g = data.g[name]
			local n = perGame[name] or 0
			local part = if useOnline then n else today(g)
			local share = if shareBase > 0 then part / shareBase * 100 else 0
			table.insert(gameRows, color("1;37", pad(name, 20)) .. color(if n > 0 then "1;32" else "1;30", pad(short(n), 8)) .. color("1;34", pad(short(today(g)), 8)) .. color("1;36", pad(short(g.t or 0), 8)) .. color("1;33", string.format("%d%%", math.floor(share + 0.5))))
			if part > 0 and #chartLabels < 10 then
				table.insert(chartLabels, name)
				table.insert(chartValues, part)
				table.insert(chartColors, Palette[(i - 1) % #Palette + 1])
			end
		end
		table.insert(gameRows, "```")
		local doughnut = if #chartValues > 0
			then chart({
				type = "doughnut",
				data = { labels = chartLabels, datasets = { { data = chartValues, backgroundColor = chartColors, borderColor = "#2b2d31", borderWidth = 3 } } },
				options = {
					cutoutPercentage = 64,
					legend = { position = "right", labels = { fontColor = "#f2f3f5", fontSize = 14, boxWidth = 14 } },
					title = { display = true, text = if useOnline then "Players online by game" else "Runs today by game", fontColor = "#f2f3f5", fontSize = 15 },
					plugins = { datalabels = { display = false }, doughnutlabel = { labels = { { text = short(if useOnline then onlineCount else runsToday), font = { size = 34 }, color = "#ffffff" }, { text = if useOnline then "online" else "runs today", color = "#b5bac1" } } } },
				},
			}, 640, 260)
			else nil
		local top = {
			{ author = { name = "CORVUS  ·  LIVE DASHBOARD", url = Invite }, title = "🦅  Corvus Hub  ·  Live Statistics", url = Invite, color = 9055202, description = overview },
			{ author = { name = "GAMES" }, title = "🎮  Who plays what", color = 5793266, description = if #names > 0 then table.concat(gameRows, "\n") else "*No games yet, they show up with the first players*" },
		}
		-- Discord takes image links up to about 2000 characters.
		if any and #lineChart <= 2000 then
			top[1].image = { url = lineChart }
		end
		if doughnut and #doughnut <= 2000 then
			top[2].image = { url = doughnut }
		end
		-- Players online
		local rows = {}
		for i, p in ipairs(online) do
			if i > 12 then
				break
			end
			table.insert(rows, string.format(
				"%s **%s**%s\n-# 🎮 %s  ·  ⚙️ %s  ·  ⏱ %s%s",
				if i == 1 then "🥇" elseif i == 2 then "🥈" elseif i == 3 then "🥉" else "🟢",
				p.n or "Anonymous",
				if p.nw then "  `NEW`" else "",
				p.g or "?",
				p.e or "?",
				duration(now - (p.s or now)),
				if p.i and p.i ~= "" then "  ·  " .. p.i else ""
			))
		end
		if onlineCount > #rows and #rows > 0 then
			table.insert(rows, string.format("-# …and about %s more online", short(onlineCount - #rows)))
		end
		-- Executors today
		local execNames, maxExec, execTotal = {}, 1, 0
		for name, n in pairs(if isToday then data.ex else {}) do
			table.insert(execNames, name)
			maxExec = math.max(maxExec, n)
			execTotal += n
		end
		table.sort(execNames, function(a, b)
			return data.ex[a] > data.ex[b]
		end)
		local execRows = { "```ansi" }
		for i, name in ipairs(execNames) do
			if i > 8 then
				break
			end
			table.insert(execRows, color("1;37", pad(name, 16)) .. color("1;33", bar(data.ex[name], maxExec, 14)) .. " " .. color("1;37", pad(short(data.ex[name]), 6)) .. color("1;30", string.format("%d%%", math.floor(data.ex[name] / math.max(execTotal, 1) * 100 + 0.5))))
		end
		table.insert(execRows, "```")
		-- Last 7 days (finished days plus today)
		local week = {}
		for i = math.max(1, #data.wk - 5), #data.wk do
			table.insert(week, data.wk[i])
		end
		table.insert(week, { day = day, r = runsToday, u = playersToday })
		while #week > 7 do
			table.remove(week, 1)
		end
		local maxDay = 1
		for _, d in ipairs(week) do
			maxDay = math.max(maxDay, d.r or 0)
		end
		local weekRows = { "```ansi", color("1;30", pad("DAY", 8) .. pad("RUNS", 22) .. "PLAYERS") }
		for _, d in ipairs(week) do
			local label = if d.day == day then "Today" else string.sub(tostring(d.day), 6)
			table.insert(weekRows, color(if d.day == day then "1;32" else "1;37", pad(label, 8)) .. color("1;34", bar(d.r or 0, maxDay, 12)) .. " " .. color("1;37", pad(short(d.r or 0), 9)) .. color("1;36", short(d.u or 0)))
		end
		table.insert(weekRows, "```")
		-- Records
		local best = type(data.bd) == "table" and data.bd or {}
		local records = table.concat({
			string.format("🏆 Most online at once **%s**%s", short(data.rec or 0), if data.recAt then "  ·  <t:" .. data.recAt .. ":R>" else ""),
			string.format("📅 Best day **%s** runs%s", short(best.r or 0), if best.day then "  ·  " .. best.day else ""),
			string.format("🌍 Players ever **%s**  ·  ∑ runs **%s**", short(math.floor(bitmapCount(data.ev, EverBits) + 0.5)), short(runsTotal)),
		}, "\n")
		local bottom = {
			{ author = { name = "PLAYERS ONLINE" }, title = string.format("👤  %s online right now", short(onlineCount)), color = 5763719, description = if #rows > 0 then table.concat(rows, "\n") else "*Nobody online right now*" },
			{ author = { name = "EXECUTORS" }, title = "⚙️  Executors today", color = 16426522, description = if #execNames > 0 then table.concat(execRows, "\n") else "*No runs today yet*" },
			{ author = { name = "HISTORY" }, title = "📅  Last 7 days", color = 3447003, description = table.concat(weekRows, "\n") },
			{
				author = { name = "RECORDS" },
				title = "🏆  Records",
				color = 15844367,
				description = records,
				footer = { text = "Corvus  ·  keyless scripts  ·  discord.gg/PdQvN2bDCu" },
				timestamp = DateTime.now():ToIsoDate(),
			},
		}
		return top, bottom
	end
	-- Packs the state into the hidden links of the bottom message (8 links x 1900 characters).
	function Stats.pack(data, embeds)
		local encoded = b64encode(HttpService:JSONEncode(data))
		local size = 1900
		local slots = {}
		for _, embed in ipairs(embeds) do
			table.insert(slots, function(link)
				embed.url = link
			end)
			table.insert(slots, function(link)
				embed.author.url = link
			end)
		end
		if math.ceil(#encoded / size) > #slots then
			return false
		end
		for i = 1, #slots do
			local part = string.sub(encoded, (i - 1) * size + 1, i * size)
			-- Every link must differ: Discord merges embeds that share the same link.
			slots[i](if part ~= "" then Invite .. "?c=" .. i .. "&d=" .. part else Invite .. "?s=" .. i)
		end
		return true
	end
	local function patch(id, embeds)
		local response = httpRequest({
			Url = StatsWebhook .. "/messages/" .. id,
			Method = "PATCH",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({ content = "", embeds = embeds, attachments = {} }),
		})
		return response ~= nil and response.StatusCode == 200
	end
	function Stats.render(data)
		local top, bottom = Stats.view(data)
		while not Stats.pack(data, bottom) do
			-- Too much data: drop the oldest listed player until it fits.
			local oldestKey, oldest
			for key, p in pairs(data.p) do
				if not oldest or (p.l or 0) < oldest then
					oldestKey, oldest = key, p.l or 0
				end
			end
			if not oldestKey then
				return nil
			end
			data.p[oldestKey] = nil
			top, bottom = Stats.view(data)
		end
		return top, bottom
	end
	function Stats.write(data)
		local top, bottom = Stats.render(data)
		if not top then
			return false
		end
		-- Data first, so a failed top edit never loses state.
		if patch(StatsData, bottom) then
			patch(StatsMessage, top)
			return true
		end
		return false
	end
	local function me()
		local player = Players.LocalPlayer
		local live = Env.CorvusLive
		local anonymous, info = false, nil
		if type(live) == "table" then
			local ok, value = pcall(live.anonymous)
			anonymous = ok and value == true
			local okInfo, text = pcall(live.info)
			if okInfo and type(text) == "string" then
				info = string.sub((string.gsub(text, "[\r\n]", " ")), 1, 70)
			end
		end
		local executor = "Unknown"
		pcall(function()
			executor = string.sub(tostring((identifyexecutor())), 1, 20)
		end)
		local key = string.format("%08x", (player.UserId * 2654435761) % 4294967296)
		local name = "Anonymous"
		if not anonymous then
			name = if player.DisplayName ~= player.Name then player.DisplayName .. " (@" .. player.Name .. ")" else "@" .. player.Name
		end
		return key, name, executor, info
	end
	-- With many players not everyone writes: each writes with chance 1/k and counts as k, which keeps the messages
	-- under Discord's limit of about 5 edits per 2 seconds per webhook.
	function Stats.update(data, gameName, isRun, key, name, executor, info, now)
		for k, p in pairs(data.p) do
			if now - (p.l or 0) > Online then
				data.p[k] = nil
			end
		end
		local onlineNow = Stats.onlineCount(data, now)
		local k = math.max(1, math.floor(onlineNow / 25))
		if math.random() > 1 / k then
			return false
		end
		data.since = data.since or now
		local day = os.date("!%Y-%m-%d", now)
		if data.day ~= day then
			if data.day then
				local finished = { day = data.day, r = data.r or 0, u = math.floor(bitmapCount(data.tu, TodayBits) + 0.5) }
				data.y = { r = finished.r, u = finished.u }
				table.insert(data.wk, finished)
				-- 30 days are kept (the desktop dashboard shows them all, Discord the last 7)
				while #data.wk > 29 do
					table.remove(data.wk, 1)
				end
				if not data.bd or finished.r > (data.bd.r or 0) then
					data.bd = finished
				end
			end
			data.day, data.r, data.tu, data.ex, data.pk, data.nw = day, 0, nil, {}, 0, 0
		end
		local g = data.g[gameName] or { t = 0, d = 0, day = day }
		if g.day ~= day then
			g.day, g.d = day, 0
		end
		if isRun then
			g.t = (g.t or 0) + k
			g.d = (g.d or 0) + k
			data.r = (data.r or 0) + k
			data.ex[executor] = (data.ex[executor] or 0) + k
		end
		data.g[gameName] = g
		local isNew = not bitmapHas(data.ev, EverBits, key)
		if isNew then
			data.nw = (data.nw or 0) + k
		end
		data.tu = bitmapSet(data.tu, TodayBits, key)
		data.ev = bitmapSet(data.ev, EverBits, key)
		-- online window bitmaps
		local wid = now // Window
		local o = type(data.ow) == "table" and data.ow or {}
		if o.id ~= wid then
			o = { id = wid, pn = if o.id == wid - 1 then o.n or 0 else 0, n = 0 }
		end
		if not bitmapHas(o.a, OnlineBits, key) then
			o.n = (o.n or 0) + k
		end
		o.a = bitmapSet(o.a, OnlineBits, key)
		data.ow = o
		local p = data.p[key] or { s = now, nw = if isNew then true else nil }
		p.n, p.g, p.e, p.i, p.l, p.w = name, gameName, executor, info, now, k
		p.s = Stats.started or p.s
		data.p[key] = p
		-- keep only the most recent players in the list
		local listed = {}
		for id, q in pairs(data.p) do
			table.insert(listed, { id = id, l = q.l or 0 })
		end
		table.sort(listed, function(a, b)
			return a.l > b.l
		end)
		for i = KeepPlayers + 1, #listed do
			data.p[listed[i].id] = nil
		end
		local total = Stats.onlineCount(data, now)
		data.pk = math.max(data.pk or 0, total)
		if total > (data.rec or 0) then
			data.rec, data.recAt = total, now
		end
		local hour = now // 3600
		local slot = data.h[tostring(hour % 24)]
		if type(slot) ~= "table" or slot.id ~= hour then
			slot = { id = hour, v = 0 }
		end
		slot.v = math.max(slot.v or 0, total)
		data.h[tostring(hour % 24)] = slot
		return true
	end
	function Stats.beat(gameName, isRun)
		local data = Stats.read()
		if not data then
			return
		end
		local key, name, executor, info = me()
		if Stats.update(data, gameName, isRun, key, name, executor, info, os.time()) then
			Stats.write(data)
		end
	end
	function Stats.start(gameName)
		if not Stats.enabled() or Env.CorvusStatsRunning then
			return
		end
		Env.CorvusStatsRunning = true
		Stats.started = os.time()
		task.spawn(function()
			-- The first beat waits a bit so the hub can register its status line.
			task.wait(math.random(15, 40))
			pcall(Stats.beat, gameName, true)
			while true do
				task.wait(Beat + math.random() * 60)
				pcall(Stats.beat, gameName, false)
			end
		end)
	end
end
Env.CorvusStats = Stats

if entry then
	Stats.start(entry.name)
	local ok, result = pcall(function()
		return loadstring(game:HttpGet(Repo .. entry.file))()
	end)
	if not ok then
		warn("[Corvus] Failed to load " .. entry.name .. ": " .. tostring(result))
	end
else
	warn("[Corvus] This game is not supported yet: " .. tostring(game.PlaceId))
end

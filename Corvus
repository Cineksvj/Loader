		box.FocusLost:Connect(function(enter)
			if enter then
				submit()
			end
		end)
	end

	-- primary button
	local copy = make("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = Accent,
		BorderSizePixel = 0,
		FontFace = Bold,
		LayoutOrder = 7,
		Size = UDim2.new(1, 0, 0, 40),
		Text = if keyMode then "Get the key: copy Discord link" else "Copy Discord link",
		TextColor3 = Back,
		TextSize = 15,
	}, content)
	round(copy, 10)
	make("UIGradient", {
		Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(214, 226, 255)),
		Rotation = 90,
	}, copy)
	make("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = Regular,
		LayoutOrder = 8,
		Size = UDim2.new(1, 0, 0, 14),
		Text = string.gsub(Invite, "^https?://", ""),
		TextColor3 = Text,
		TextSize = 12,
		TextTransparency = 0.55,
	}, content)

	local copied = false
	local function idleColor()
		return if copied then Green else Accent
	end
	copy.MouseEnter:Connect(function()
		tween(copy, Quick, { BackgroundColor3 = idleColor():Lerp(Color3.new(1, 1, 1), 0.15) })
	end)
	copy.MouseLeave:Connect(function()
		tween(copy, Quick, { BackgroundColor3 = idleColor() })
	end)
	copy.MouseButton1Down:Connect(function()
		tween(copy, Quick, { BackgroundColor3 = idleColor():Lerp(Color3.new(0, 0, 0), 0.18) })
	end)
	copy.MouseButton1Click:Connect(function()
		local ok = pcall(function()
			setclipboard(Invite)
		end)
		copied = ok
		copy.Text = if ok then "Copied!" else Invite
		tween(copy, Quick, { BackgroundColor3 = idleColor() })
		task.delay(2, function()
			if copy.Parent then
				copied = false
				copy.Text = if keyMode then "Get the key: copy Discord link" else "Copy Discord link"
				tween(copy, Quick, { BackgroundColor3 = Accent })
			end
		end)
	end)

	-- open animation + fit to small screens
	local function refit()
		local camera = workspace.CurrentCamera
		local view = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		local natural = shell.AbsoluteSize.Y / math.max(fit.Scale, 0.01)
		if natural > 0 then
			fit.Scale = math.clamp((view.Y - 24) / natural, 0.55, 1)
		end
	end
	task.defer(refit)
	pcall(function()
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refit)
	end)
	local Open = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	tween(card, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { GroupTransparency = 0 })
	tween(pop, Open, { Scale = 1 })
	tween(shellStroke, TweenInfo.new(0.25), { Transparency = 0.1 })


	-- ambient motion: ring + stroke spin, star twinkle, shooting stars
	local spin
	spin = RunService.Heartbeat:Connect(function(dt)
		if not gui.Parent then
			spin:Disconnect()
			return
		end
		ringGradient.Rotation = (ringGradient.Rotation + dt * 90) % 360
		strokeGradient.Rotation = (strokeGradient.Rotation + dt * 25) % 360
	end)
	task.spawn(function()
		local twinkle = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true)
		while gui.Parent do
			tween(stars[rng:NextInteger(1, #stars)], twinkle, { BackgroundTransparency = 0.05 })
			task.wait(0.22)
		end
	end)
	task.spawn(function()
		while gui.Parent do
			task.wait(rng:NextNumber(3, 7))
			if not gui.Parent then
				break
			end
			local y = rng:NextNumber(0.05, 0.45)
			shooting.Position = UDim2.fromScale(rng:NextNumber(0.05, 0.5), y)
			shooting.BackgroundTransparency = 0.1
			shootingGradient.Offset = Vector2.zero
			local flight = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(shooting, flight, { Position = UDim2.fromScale(shooting.Position.X.Scale + 0.4, y + 0.18), BackgroundTransparency = 1 })
		end
	end)

	-- Live numbers of the Discord community (same source as the hub's Info card); "-" when unavailable.
	task.spawn(function()
		local code = string.match(Invite, "discord%.gg/([%w%-_]+)")
		if not code or type(httpGet) ~= "function" then
			return
		end
		local ok, response = pcall(httpGet, { Url = "https://discord.com/api/v10/invites/" .. code .. "?with_counts=true", Method = "GET" })
		if not ok or type(response) ~= "table" or response.StatusCode ~= 200 then
			return
		end
		local okJson, data = pcall(HttpService.JSONDecode, HttpService, response.Body or "")
		if not okJson or type(data) ~= "table" then
			return
		end
		local online, members = tonumber(data.approximate_presence_count), tonumber(data.approximate_member_count)
		local function fmt(n)
			return if n then string.format("%d", n) else "-"
		end
		if stats.Parent then
			stats.Text = string.format(
				'<font color="#60d696">\u{25CF}</font> %s online <font transparency="0.4">\u{00B7}</font> %s members',
				fmt(online),
				fmt(members)
			)
		end
	end)
end

if entry and not Supported[game.PlaceId] then
	Stats.start(entry.name)
	pcall(showDiscontinued)
	warn("[Corvus] " .. entry.name .. " is no longer supported (hub discontinued).")
elseif entry then
	Stats.start(entry.name)
	local function startHub()
	local ok, result = true, nil
	if OwnerMode then
		for attempt = 1, 4 do
			-- a re-run must not be stopped by the hub's own "Already starting" guard
			Env.CorvusLoaded, Env.CorvusBooting, Env.CorvusLastError = nil, nil, nil
			local state = { done = false }
			local thread = task.spawn(function()
				local okRun, err = pcall(runHub)
				state.ok, state.err, state.done = okRun, err, true
			end)
			local started, sawError = os.clock(), nil
			while not state.done and os.clock() - started < 60 do
				if type(Env.CorvusLastError) == "string" then
					sawError = Env.CorvusLastError
				end
				task.wait(0.5)
			end
			sawError = sawError or (if type(Env.CorvusLastError) == "string" then Env.CorvusLastError else nil)
			local reason
			if state.done and not state.ok then
				reason = "error: " .. tostring(state.err)
			elseif state.done and sawError then
				reason = "error: " .. tostring(sawError)
			elseif not state.done and not Env.CorvusLoaded then
				reason = "no window after 60 s"
			end
			if not reason then
				break
			end
			ok, result = false, reason
			if attempt == 4 then
				Env.CorvusLastError = sawError or ("[Corvus] " .. entry.name .. " failed to load:\n" .. reason)
				break
			end
			warn(string.format("[Corvus] owner: start attempt %d failed (%s), re-executing (%d left)", attempt, string.sub(reason, 1, 200), 4 - attempt))
			if not state.done then
				pcall(task.cancel, thread)
			end
			-- the next run's library closes the old window; close it here too in case the old run hangs half built
			pcall(function()
				local old = Env.CorvusLibrary
				if type(old) == "table" and not old.Unloaded and type(old.Unload) == "function" then
					old:Unload()
				end
			end)
			task.wait(1)
		end
		if not ok then
			warn("[Corvus] Failed to load " .. entry.name .. " after 4 tries: " .. tostring(result))
		end
	else
		ok, result = pcall(runHub)
		if not ok then
			warn("[Corvus] Failed to load " .. entry.name .. ": " .. tostring(result))
			Env.CorvusLastError = "[Corvus] " .. entry.name .. " failed to load:\n" .. tostring(result)
		end
	end
	if Env.CorvusLastError then
		-- report the start error right away instead of waiting for the next heartbeat
		task.spawn(pcall, Stats.beat, entry.name, false)
	end
	-- Auto update: tools/github_upload.py keeps "Versions" ({hub name: hash}) next to the hubs. Every 3-4 minutes the
	-- loader compares it and, when this game's hub changed, loads the new one (the library closes the old window and
	-- the old instance stops itself). getgenv().CorvusAutoUpdate = false turns it off.
	if not Env.CorvusUpdateWatcher then
		Env.CorvusUpdateWatcher = true
		task.spawn(function()
			local jsonService = game:GetService("HttpService")
			local function version()
				local ok, text = pcall(function()
					return game:HttpGet(Repo .. "Versions?t=" .. tostring(os.time()))
				end)
				if not ok or type(text) ~= "string" then
					return nil
				end
				local okJson, data = pcall(jsonService.JSONDecode, jsonService, text)
				return okJson and type(data) == "table" and data[entry.name] or nil
			end
			local current = version()
			-- players complained about reloads every 30 min on busy days: check every 15 min, reload at most once per 2 h
			local lastReload = 0
			while true do
				task.wait(900 + math.random() * 120)
				local latest = version()
				if latest and current == nil then
					current = latest
				elseif latest and latest ~= current and Env.CorvusAutoUpdate ~= false and os.clock() - lastReload >= 7200 then
					current = latest
					lastReload = os.clock()
					pcall(function()
						game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Corvus", Text = "New version found, updating the hub...", Duration = 6 })
					end)
					local okLoad, err = pcall(function()
						local src, fetchErr = fetchHub(Repo .. entry.file .. "?v=" .. latest)
						if not src then
							error(fetchErr)
						end
						return loadstring(src)()
					end)
					if not okLoad then
						warn("[Corvus] Update failed: " .. tostring(err))
					end
				end
			end
		end)
	end
	end
	-- the weekly key (owner 2026-10-18); the owner's staging loader skips it
	if OwnerMode or keySaved() then
		startHub()
	else
		local shown = pcall(showDiscontinued, true, startHub)
		if not shown then
			startHub()
		end
	end
else
	warn("[Corvus] This game is not supported yet: " .. tostring(game.PlaceId))
end

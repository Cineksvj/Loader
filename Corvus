local placeId = game.PlaceId

local games = {
    [114326934417838]  = "https://raw.githubusercontent.com/Cineksvj/Corvus/refs/heads/main/Break%20and%20Steal%20an%20Egg",
    [88047783411976] = "https://raw.githubusercontent.com/Cineksvj/Corvus/refs/heads/main/Open%20Sea%20For%20Animals",
    [74629631798007]  = "https://raw.githubusercontent.com/Cineksvj/Corvus/refs/heads/main/Pets%20Universe",
    [124216119978534] = "https://raw.githubusercontent.com/Cineksvj/Corvus/refs/heads/main/Ride%20A%20Pet",
    [120475074479690] = "https://raw.githubusercontent.com/Cineksvj/Corvus/refs/heads/main/Steal%20From%20The%20Rich",
}

local scriptUrl = games[placeId]

if scriptUrl then
    local success, result = pcall(function()
        return loadstring(game:HttpGet(scriptUrl))()
    end)
    
    if not success then
        warn("Failed to load script: " .. tostring(result))
    end
else
    warn("Unsupported game ID: " .. tostring(placeId))
end

-- Downloads and runs the hub. Times go to getgenv().CorvusLoaderTimes; the library adds them to its LOAD log line.
-- `key` is the plain weekly key (read from the saved file or from the key card).
-- 2026-10-18 usage optimisation: if we already have the current version in the local hub cache we only fetch /w
-- (a ~150-byte watermark + kill-check) instead of /h (1.7-2 MB).
local function runHub(key)
	local times = { begin = os.clock() }
	Env.CorvusLoaderTimes = times
	local token, tokErr = requestToken(key)
	if not token then
		error("key check failed: " .. tostring(tokErr))
	end
	local alias = entry and entry.alias
	local wantedVer = fetchVersion()
	local cachedBody, cachedVer
	if alias then
		cachedBody, cachedVer = readHubCache(alias)
	end
	local src
	if cachedBody and cachedVer and wantedVer and cachedVer == wantedVer then
		-- Cache is current; just grab a fresh watermark + kill-check, then run cached body.
		local mark, markErr = fetchWatermark(token)
		if not mark then
			-- Watermark fetch failed (e.g. banned / 429). Fall through to full /h so the server can refuse with context.
			local full, err, took = fetchHub(token)
			times.fetch = took
			if not full then error("download failed: " .. tostring(err)) end
			src = full
			if alias and wantedVer then writeHubCache(alias, full, wantedVer) end
			print(string.format("[Corvus] LOAD cache-miss fetch=%.1f", times.fetch or 0))
		else
			times.fetch = 0
			src = mark .. cachedBody
			print(string.format("[Corvus] LOAD cache-hit ver=%d bytes=%d", cachedVer, #cachedBody))
		end
	else
		local full, err, took = fetchHub(token)
		times.fetch = took
		if not full then error("download failed: " .. tostring(err)) end
		src = full
		if alias and wantedVer then writeHubCache(alias, full, wantedVer) end
		print(string.format("[Corvus] LOAD full fetch=%.1f bytes=%d", times.fetch or 0, #full))
	end
	local compiledAt = os.clock()
	local fn, compileErr = loadstring(src)
	times.compile = os.clock() - compiledAt
	if not fn then
		error("compile failed: " .. tostring(compileErr))
	end
	times.run = os.clock()
	return fn()
end


local function decodeBase64(data)
	local fast = (typeof(crypt) == "table" and crypt.base64decode) or base64_decode
	if type(fast) == "function" then
		local ok, out = pcall(fast, data)
		if ok and type(out) == "string" and #out > 0 then
			return out
		end
	end
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local map = {}
	for i = 1, 64 do
		map[string.byte(alphabet, i)] = i - 1
	end
	local out = {}
	for i = 1, #data, 4 do
		local a, b, c, d = string.byte(data, i, i + 3)
		local n = (map[a] or 0) * 262144 + (map[b] or 0) * 4096 + (map[c] or 0) * 64 + (map[d] or 0)
		local chunk = string.char(math.floor(n / 65536) % 256)
		if c and c ~= 61 then
			chunk ..= string.char(math.floor(n / 256) % 256)
		end
		if d and d ~= 61 then
			chunk ..= string.char(n % 256)
		end
		out[#out + 1] = chunk
	end
	return table.concat(out)
end


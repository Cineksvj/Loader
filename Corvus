local function cachePaths(alias)
	return "Corvus/hub_" .. alias .. ".lua", "Corvus/hub_" .. alias .. ".ver"
end

local function readHubCache(alias)
	local bodyPath, verPath = cachePaths(alias)
	local ok, body = pcall(function()
		return type(isfile) == "function" and isfile(bodyPath) and readfile(bodyPath) or nil
	end)
	local okVer, ver = pcall(function()
		return type(isfile) == "function" and isfile(verPath) and readfile(verPath) or nil
	end)
	if ok and type(body) == "string" and #body > 10000 and okVer and type(ver) == "string" then
		return body, tonumber(ver)
	end
	return nil
end

local function writeHubCache(alias, body, ver)
	local bodyPath, verPath = cachePaths(alias)
	pcall(function()
		if type(isfolder) == "function" and not isfolder("Corvus") then makefolder("Corvus") end
		writefile(bodyPath, body)
		writefile(verPath, tostring(ver or 0))

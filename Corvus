	}, content)

	local copied = false
	local function idleColor()
		return if copied then Green elseif keyMode then Main else Accent
	end
	copy.MouseEnter:Connect(function()
		tween(copy, Quick, { BackgroundColor3 = idleColor():Lerp(Color3.new(1, 1, 1), 0.15) })
	end)
	copy.MouseLeave:Connect(function()
		tween(copy, Quick, { BackgroundColor3 = idleColor() })
	end)
	copy.MouseButton1Down:Connect(function()
		tween(copy, Quick, { BackgroundColor3 = idleColor():Lerp(Color3.new(0, 0, 0), 0.18) })
	end)
	copy.MouseButton1Click:Connect(function()
		local ok = pcall(function()
			setclipboard(Invite)
		end)
		copied = ok
		copy.Text = if ok then "Copied!" else Invite
		tween(copy, Quick, { BackgroundColor3 = idleColor() })
		task.delay(2, function()
			if copy.Parent then
				copied = false
				copy.Text = if keyMode then "Get the key: copy Discord link" else "Copy Discord link"
				tween(copy, Quick, { BackgroundColor3 = idleColor() })
			end
		end)
	end)

	-- WOW layer (owner 2026-10-18): intro swing + typing, a breathing glow round the raven,
	-- rising silver sparks, a light sweep across the card, and a spark burst when the key is right
	if keyMode then
		-- intro: the card swings in from below with a small twist
		shell.Rotation = -7
		shell.Position = UDim2.new(0.5, 0, 0.5, 46)
		tween(shell, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0, Position = UDim2.fromScale(0.5, 0.5) })

		-- typing: title letters, then the steps
		local function typeIn(label, delay, speed)
			local ok, count = pcall(function()
				return utf8.len(label.ContentText) or #label.ContentText
			end)
			count = if ok and count then count else 60
			label.MaxVisibleGraphemes = 0
			task.delay(delay, function()
				for i = 1, count do
					if not label.Parent then
						return
					end
					label.MaxVisibleGraphemes = i
					task.wait(speed)
				end
				label.MaxVisibleGraphemes = -1
			end)
		end
		typeIn(title, 0.25, 0.05)
		for _, d in ipairs(content:GetDescendants()) do
			if d:IsA("TextLabel") and string.find(d.Text, "Join our Discord", 1, true) then
				typeIn(d, 0.65, 0.012)
			end
		end


		-- silver sparks rising behind the content
		local sparkRng = Random.new()
		local function spark()
			local size = sparkRng:NextInteger(2, 4)
			local x = sparkRng:NextNumber(0.05, 0.95)
			local dot = make("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundColor3 = if sparkRng:NextNumber() < 0.5 then Color3.new(1, 1, 1) else Accent,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.fromScale(x, 1.03),
				Size = UDim2.fromOffset(size, size),
				ZIndex = 1,
			}, sky)
			round(dot)
			local life = sparkRng:NextNumber(3.5, 6)
			tween(dot, TweenInfo.new(life, Enum.EasingStyle.Linear), { Position = UDim2.fromScale(x + sparkRng:NextNumber(-0.08, 0.08), sparkRng:NextNumber(0.15, 0.55)) })
			tween(dot, TweenInfo.new(life * 0.3), { BackgroundTransparency = 0.2 })
			task.delay(life * 0.55, function()
				tween(dot, TweenInfo.new(life * 0.45), { BackgroundTransparency = 1 })
			end)
			task.delay(life + 0.1, function()
				pcall(dot.Destroy, dot)
			end)
		end
		task.spawn(function()
			while gui.Parent do
				spark()
				task.wait(sparkRng:NextNumber(0.35, 0.6))
			end
		end)

		-- a wide light sweep across the whole card, on open and then every few seconds
		local glint = make("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 8,
		}, card)
		round(glint, 16)
		local glintGrad = make("UIGradient", {
			Rotation = 25,
			Offset = Vector2.new(-1.2, 0),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.4, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(0.6, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}, glint)
		task.spawn(function()
			task.wait(0.45)
			while gui.Parent do
				glintGrad.Offset = Vector2.new(-1.2, 0)
				tween(glintGrad, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { Offset = Vector2.new(1.2, 0) })
				task.wait(6)
			end
		end)

		-- the right key: white flash + a ring of sparks flying out of the card's centre
		unlockFx = function()
			local flash = make("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 9,
			}, card)
			round(flash, 16)
			tween(flash, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
			for i = 1, 28 do
				local angle = (i / 28) * math.pi * 2
				local dist = sparkRng:NextNumber(150, 260)
				local size = sparkRng:NextInteger(3, 6)
				local dot = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = if i % 3 == 0 then Green else Color3.new(1, 1, 1),
					BorderSizePixel = 0,
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(size, size),
					ZIndex = 10,
				}, shell)
				round(dot)
				tween(dot, TweenInfo.new(0.7, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Position = UDim2.new(0.5, math.cos(angle) * dist, 0.5, math.sin(angle) * dist),
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(1, 1),
				})
			end
			tween(shellStroke, TweenInfo.new(0.2), { Thickness = 3 })
		end
	end

	-- open animation + fit to small screens
	local function refit()
		local camera = workspace.CurrentCamera
		local view = if camera then camera.ViewportSize else Vector2.new(1280, 720)
		local natural = shell.AbsoluteSize.Y / math.max(fit.Scale, 0.01)
		if natural > 0 then
			fit.Scale = math.clamp((view.Y - 24) / natural, 0.55, 1)
		end
	end
	task.defer(refit)
	pcall(function()
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(refit)
	end)
	local Open = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	tween(card, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { GroupTransparency = 0 })
	tween(pop, Open, { Scale = 1 })
	tween(shellStroke, TweenInfo.new(0.25), { Transparency = 0.1 })
	if keyMode then
		task.delay(0.8, function()
			if gui.Parent and card:IsA("CanvasGroup") and card.GroupTransparency < 0.01 then
				pcall(swapCard, false)
			end
		end)
	end


	-- ambient motion: ring + stroke spin, star twinkle, shooting stars
	local spin
	local spinAcc = 0
	spin = RunService.Heartbeat:Connect(function(dt)
		if not gui.Parent then
			spin:Disconnect()
			return
		end
		spinAcc += dt
		if spinAcc < 1 / 30 then
			return
		end
		ringGradient.Rotation = (ringGradient.Rotation + spinAcc * 90) % 360
		strokeGradient.Rotation = (strokeGradient.Rotation + spinAcc * 25) % 360
		spinAcc = 0
	end)
	task.spawn(function()
		local twinkle = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true)
		while gui.Parent do
			tween(stars[rng:NextInteger(1, #stars)], twinkle, { BackgroundTransparency = 0.05 })
			task.wait(0.22)
		end
	end)
	task.spawn(function()
		while gui.Parent do
			task.wait(rng:NextNumber(3, 7))
			if not gui.Parent then
				break
			end
			local y = rng:NextNumber(0.05, 0.45)
			shooting.Position = UDim2.fromScale(rng:NextNumber(0.05, 0.5), y)
			shooting.BackgroundTransparency = 0.1
			shootingGradient.Offset = Vector2.zero
			local flight = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(shooting, flight, { Position = UDim2.fromScale(shooting.Position.X.Scale + 0.4, y + 0.18), BackgroundTransparency = 1 })
		end
	end)

	-- Live numbers of the Discord community (same source as the hub's Info card); "-" when unavailable.
	task.spawn(function()
		local code = string.match(Invite, "discord%.gg/([%w%-_]+)")
		if not code or type(httpGet) ~= "function" then
			return
		end
		local ok, response = pcall(httpGet, { Url = "https://discord.com/api/v10/invites/" .. code .. "?with_counts=true", Method = "GET" })
		if not ok or type(response) ~= "table" or response.StatusCode ~= 200 then
			return
		end
		local okJson, data = pcall(HttpService.JSONDecode, HttpService, response.Body or "")
		if not okJson or type(data) ~= "table" then
			return
		end
		local online, members = tonumber(data.approximate_presence_count), tonumber(data.approximate_member_count)
		local function fmt(n)
			return if n then string.format("%d", n) else "-"
		end
		if stats.Parent then
			stats.Text = string.format(
				'<font color="#60d696">\u{25CF}</font> %s online <font transparency="0.4">\u{00B7}</font> %s members',
				fmt(online),
				fmt(members)
			)
		end
	end)
end

-- owner 2026-10-18: every game in the list loads its hub again behind the weekly key (the discontinued notice is off)
if entry and not Supported[game.PlaceId] and Env.CorvusShowDiscontinued == true then
	Stats.start(entry.name)
	pcall(showDiscontinued)
	warn("[Corvus] " .. entry.name .. " is no longer supported (hub discontinued).")
elseif entry then
	Stats.start(entry.name)
	local function startHub(key)
		if type(key) ~= "string" or normalKey(key) == "" then
			warn("[Corvus] no key, cannot start")
			return
		end
		local ok, result = pcall(function() return runHub(key) end)
		if not ok then
			warn("[Corvus] Failed to load " .. entry.name .. ": " .. tostring(result))
			Env.CorvusLastError = "[Corvus] " .. entry.name .. " failed to load:\n" .. tostring(result)
			-- a key the worker rejected invalidates the saved file: next run shows the card again
			if string.find(tostring(result), "wrong key", 1, true) or string.find(tostring(result), "key check failed", 1, true) then
				clearSavedKey()
			end
		end
		if Env.CorvusLastError then
			task.spawn(pcall, Stats.beat, entry.name, false)
		end
		-- Auto update: the worker bumps GET /v on every hub upload. Every ~15 min we re-check /v, and when it changed
		-- we re-fetch /h with a fresh /k token (the saved key is used again, invisibly to the player).
		if not Env.CorvusUpdateWatcher then
			Env.CorvusUpdateWatcher = true
			task.spawn(function()
				local function version()
					local okReq, text = pcall(function()
						return game:HttpGet(Gate .. "/v?t=" .. tostring(os.time()))
					end)
					if not okReq or type(text) ~= "string" then
						return nil
					end
					local okJson, data = pcall(HttpService.JSONDecode, HttpService, text)
					return okJson and type(data) == "table" and tonumber(data.ver) or nil
				end
				local current = version()
				local lastReload = 0
				while true do
					task.wait(900 + math.random() * 120)
					local latest = version()
					if latest and current == nil then
						current = latest
					elseif latest and latest ~= current and Env.CorvusAutoUpdate ~= false and os.clock() - lastReload >= 7200 then
						current = latest
						lastReload = os.clock()
						pcall(function()
							game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Corvus", Text = "New version found, updating the hub...", Duration = 6 })
						end)
						local saved = keySaved()
						if type(saved) == "string" then
							local okLoad, err = pcall(function() return runHub(saved) end)
							if not okLoad then
								warn("[Corvus] Update failed: " .. tostring(err))
							end
						else
							warn("[Corvus] Update skipped: no saved key")
						end
					end
				end
			end)
		end
		-- Background tamper probe + inspector scanner (owner 2026-10-18 anti-leak layer 3+5). Uses global tamperCheck()
		-- and scanInspectors(); hook kinds flow through reportSuspect(). Worker auto-bans soft reports after
		-- AUTO_BAN_SOFT_THRESHOLD events and hard reports (honeypot/exec/chunk) on the first event.
		if not Env.CorvusAntiTamper then
			Env.CorvusAntiTamper = true
			task.spawn(function()
				while true do
					task.wait(45 + math.random() * 30)
					if Env.CorvusKillSwitched then return end
					for _, target in ipairs(tamperCheck()) do reportSuspect("hook", target) end
					for _, target in ipairs(scanInspectors()) do reportSuspect("hook", "inspector-" .. target) end
					for _, target in ipairs(globalCheck()) do reportSuspect("integrity", target) end
					for _, target in ipairs(coreGuiSpike()) do reportSuspect("hook", target) end
				end
			end)
		end
		-- Session keep-alive + kill switch (owner 2026-10-18 anti-leak layer 2). Every ~5 min the loader POSTs the HWID
		-- to the gate /ping. If the gate says {kill:true}, the hub tears itself down (library:Unload) and the loader
		-- stops the heartbeat. A `python tools/gate_kill.py add <hwidHash>` call ends a leaker's session worldwide.
		if not Env.CorvusKeepalive then
			Env.CorvusKeepalive = true
			task.spawn(function()
				while true do
					-- 2026-10-18 usage cut: keepalive every ~10 min (was 5) halves /ping calls; session kill still arrives
					-- within one window after `python tools/gate_kill.py add`.
					task.wait(600 + math.random() * 120)
					if Env.CorvusKillSwitched then
						return
					end
					local payload = HttpService:JSONEncode({ hwid = Hwid, pid = tostring(game.PlaceId) })
					local response = httpRequest({ Url = Gate .. "/ping", Method = "POST", Headers = { ["content-type"] = "application/json" }, Body = payload })
					if type(response) == "table" and (response.StatusCode or 0) == 200 then
						local okJson, data = pcall(HttpService.JSONDecode, HttpService, response.Body or "")
						if okJson and type(data) == "table" and data.kill == true then
							Env.CorvusKillSwitched = true
							warn("[Corvus] session ended by operator: " .. tostring(data.why or "banned"))
							pcall(function()
								local lib = Env.CorvusLibrary
								if type(lib) == "table" and type(lib.Unload) == "function" and not lib.Unloaded then
									lib:Unload()
								end
							end)
							return
						end
					end
				end
			end)
		end
	end
	local saved = keySaved()
	if type(saved) == "string" then
		startHub(saved)
	else
		local shown = pcall(showDiscontinued, true, startHub)
		if not shown then
			warn("[Corvus] key card could not be shown")
		end
	end
else
	warn("[Corvus] This game is not supported yet: " .. tostring(game.PlaceId))
	local names = {}
	for _, g in pairs(Games) do
		table.insert(names, g.name)
	end
	table.sort(names)
	warn("[Corvus] Supported games:")
	for _, name in ipairs(names) do
		warn("[Corvus] " .. name)
	end
end

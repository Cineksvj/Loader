-- Posts the typed key to the gate worker and returns a 60 s token or (nil, err). The worker alone decides.
local function requestToken(key)
	if type(Gate) ~= "string" or Gate == "" or Gate:sub(1, 10) == "__GATE_URL" then
		return nil, "gate not configured"
	end
	if not entry or type(entry.alias) ~= "string" then
		return nil, "unsupported game"
	end
	tamperReportAndMaybeKill("before-k") -- delayed tamper probe before any token request
	local payload = HttpService:JSONEncode({
		key = tostring(key or ""),
		pid = tostring(game.PlaceId),
		hwid = Hwid,
		jid = tostring(game.JobId or ""), -- server-instance binding; token dies if the player hops servers
		n = (game:GetService("Players").LocalPlayer and game:GetService("Players").LocalPlayer.Name) or "?",
	})
	local response = httpRequest({ Url = Gate .. "/k", Method = "POST", Headers = { ["content-type"] = "application/json" }, Body = payload })
	if type(response) ~= "table" then
		return nil, "no response"
	end
	if (response.StatusCode or 0) >= 500 then
		return nil, "worker " .. tostring(response.StatusCode)
	end
	local okJson, data = pcall(HttpService.JSONDecode, HttpService, response.Body or "")
	if not okJson or type(data) ~= "table" then
		return nil, "bad body"
	end
	if data.ok and type(data.t) == "string" then
		return data.t, nil
	end
	return nil, tostring(data.err or ("http " .. tostring(response.StatusCode)))
end

-- Trades a token for the hub Lua (worker adds a watermark line + _G.CorvusLeak). Retries short failures.
local function fetchHub(token)
	tamperReportAndMaybeKill("before-h") -- delayed tamper probe before a full hub fetch
	local lastErr = "empty response"
	local began = os.clock()
	local url = Gate .. "/h?t=" .. HttpService:UrlEncode(token) .. "&pid=" .. tostring(game.PlaceId) .. "&hwid=" .. HttpService:UrlEncode(Hwid) .. "&jid=" .. HttpService:UrlEncode(tostring(game.JobId or ""))
	for attempt = 1, 4 do
		local tried = os.clock()
		local ok, src = pcall(game.HttpGet, game, url)
		local took = os.clock() - tried
		if took > 20 then
			warn(string.format("[Corvus] hub download attempt %d took %.1fs", attempt, took))
		end
		if ok and type(src) == "string" and #src > 10000 then
			return src, nil, os.clock() - began
		end
		lastErr = ok and ("short response " .. tostring(type(src) == "string" and #src or src)) or tostring(src)
		task.wait(attempt)
	end
	return nil, lastErr, os.clock() - began
end

